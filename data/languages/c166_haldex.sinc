RwmIndBOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & DppSet=1 & Dpp3Pg & rwm & rwm_raw!=0 & rwm_raw!=15; DataImmW & mem_dpp=3 { local o:2 = rwm + DataImmW; local pg:3 = Dpp3Pg; local a:3 = (pg << 14) | zext(o & 0x3fff); export *:1 a; }

