macro Rol(a, b){
	local tmpA = a;
	local tmpB = b;
	$(PSW_C) = tmpB != 0 && (tmpA >> (16 - tmpB)) & 1;
	$(PSW_V) = 0;
	$(PSW_E) = 0;
    local result = (tmpA << tmpB) | (tmpA >> (16 - tmpB));
    a = result;
	setPostFlags(result);
}

# ROL Rwn, Rwm
:rol rwn, rwm is ExtCountDec & op=0x0c & rwn & rwm {
	Rol(rwn, rwm);
}

