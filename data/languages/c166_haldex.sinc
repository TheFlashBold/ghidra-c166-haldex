:CoLOAD2^"-" co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x6A & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoLOAD2_neg(MAC_ACC, co_n, b); }
