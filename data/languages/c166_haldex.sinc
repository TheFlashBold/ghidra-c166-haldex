:CoSHL CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x8A & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoSHL(MAC_ACC, b, 0:2); }
:CoMACus co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x90 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMACus(MAC_ACC, co_n, b); }
