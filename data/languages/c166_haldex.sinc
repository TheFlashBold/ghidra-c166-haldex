:CoSUBR co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x12 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoSUBR(MAC_ACC, co_n, b); }
