:CoMACRus co_n, CoPtrM^", rnd" is ExtCountDec & co_op=0x83 & co_ext=0xB1 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMACRus(MAC_ACC, co_n, b); }
:CoASHR CoPtrM^", rnd" is ExtCountDec & co_op=0x83 & co_ext=0xBA & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoASHR(MAC_ACC, b, 0:2); }
:CoMUL co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0xC0 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMUL(MAC_ACC, co_n, b); }
:CoMUL co_n, CoPtrM^", rnd" is ExtCountDec & co_op=0x83 & co_ext=0xC1 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMUL(MAC_ACC, co_n, b); }
:CoCMP co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0xC2 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoCMP(MAC_ACC, co_n, b); }
