define endian=$(ENDIAN);

define alignment=2;

define space ram type=ram_space size=3 default;
define space register type=register_space size=2;

define pcodeop GetPagedOffset;
define pcodeop segment;
define pcodeop c166_switch_load;  # Special load for switch tables - injector emits segment() when followed by jmpi
define pcodeop c166_reg_offset_addr;  # [rwm+#imm] address calc - if imm<0x200: segment(0, rwm+imm), else: DPP-paged

define register offset=0 size=2
	[ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 IP ];
define register offset=0 size=1
	[ RL0 RH0 RL1 RH1 RL2 RH2 RL3 RH3 RL4 RH4 RL5 RH5 RL6 RH6 RL7 RH7 ];

define register offset=0xFE00 size=2 [ DPP0 DPP1 DPP2 DPP3 ];
define ram offset=0xFE0C size=2 [ MDH MDL ];
define ram offset=0xFF0E size=2 [ MDC ];
# XC166 (C166S V2) MAC unit + address-generation registers
define ram offset=0xFE5C size=2 [ MAL MAH ];
define ram offset=0xFE5C size=4 [ MAC_ACC ];   # MAH:MAL 32-bit accumulator view
define ram offset=0xFFDA size=2 [ MRW MCW MSW ];
define ram offset=0xFF08 size=2 [ IDX0 IDX1 ];
define ram offset=0xF000 size=2 [ QX0 QX1 QR0 QR1 ];

define register offset=0xFE08 size=2 [ CSP ];
define register offset=0xFF10 size=2 [ PSW ];

define register offset=0x50 size=16 contextreg;
define context contextreg
	Counter = (0,2)
	ExtrEn  = (3,3)
	ExtpEn  = (4,4)
	ExtsEn  = (5,5)
	Extp    = (6,21)
	Exts    = (22, 29)
	ExtpReg = (30, 33)  # Register index for register-based EXTP (0-15) when ExtpRegMode=1
	ExtsReg = (34, 37)  # Register index for register-based EXTS (0-15) when ExtsRegMode=1
	ExtpRegMode = (38, 38)  # 1 = ExtpReg holds GP register index; 0 = immediate-mode (Extp = page)
	ExtsRegMode = (39, 39)  # 1 = ExtsReg holds GP register index; 0 = immediate-mode (Exts = segment)
	# XC166/C167 DPP paging for 16-bit direct addresses (mem). Set by
	# a setup script from the startup "MOV DPPx,#imm" sequence.
	# DppSet=0 keeps the legacy identity mapping (== reset values DPPx=x).
	Dpp0Pg  = (40, 49) noflow
	Dpp1Pg  = (50, 59) noflow
	Dpp2Pg  = (64, 73) noflow
	Dpp3Pg  = (74, 83) noflow
	DppSet  = (84, 84) noflow
	ExtpRegV = (30, 33)  # alias of ExtpReg, attached to r0..r15
	ExtsRegV = (34, 37)  # alias of ExtsReg, attached to r0..r15
;

@define PSW_N "PSW[0,1]"
@define PSW_C "PSW[1,1]"
@define PSW_V "PSW[2,1]"
@define PSW_Z "PSW[3,1]"
@define PSW_E "PSW[4,1]"

macro setPreFlags(a, b) {
	$(PSW_C) = ((a + b) < a) | ((a + b) < b);
	$(PSW_V) = ((a s< 0) == (b s< 0)) & (((a + b) s< 0) != (a s< 0));
	$(PSW_E) = (b == 0x8000);
}

macro setPostFlags(result) {
	$(PSW_N) = (result s< 0);
	$(PSW_Z) = (result == 0x0);
}

macro setPreFlagsCarry(a, b) {
	local lastCarry = $(PSW_C);
	local sum = a + b;
	# Carry if (a+b) wrapped OR (a+b+c_in) would wrap
	$(PSW_C) = (sum < a) | ((sum == 0xFFFF) & lastCarry);
	local finalSum = sum + zext(lastCarry);
	$(PSW_V) = ((a s< 0) == (b s< 0)) & ((finalSum s< 0) != (a s< 0));
	$(PSW_E) = (b == 0x8000);
}

macro setPostFlagsCarry(result) {
	local lastZero = $(PSW_Z);
	$(PSW_N) = (result s< 0);
	$(PSW_Z) = (result == 0x0) && (lastZero);
}

macro setPreFlagsAnd(b) {
	$(PSW_C) = 0;
	$(PSW_V) = 0;
	$(PSW_E) = (b == 0x8000);
}

macro setPreFlagsSub(a, b) {
	$(PSW_C) = a < b;
	$(PSW_V) = ((a s< 0) != (b s< 0)) & (((a - b) s< 0) != (a s< 0));
	$(PSW_E) = (b == 0x8000);
}

macro setPreFlagsSubCarry(a, b) {
	local lastCarry = $(PSW_C);
	# Borrow if (a < b) OR ((a == b) AND borrow_in)
	$(PSW_C) = (a < b) | ((a == b) & lastCarry);
	local finalDiff = a - b - zext(lastCarry);
	$(PSW_V) = ((a s< 0) != (b s< 0)) & ((finalDiff s< 0) != (a s< 0));
	$(PSW_E) = (b == 0x8000);
}

macro setPreFlagsAshr(a, b) {
	$(PSW_C) = (b != 0) && ((a & (1 << (b-1))) > 1);
	$(PSW_V) = (b != 0) && ((a s>> b) << b) != a;
	$(PSW_E) = 0;
}

macro setPreFlagsShr(a, b) {
	$(PSW_C) = (b != 0) && ((a & (1 << (b-1))) > 1);
	$(PSW_V) = (b != 0) && ((a >> b) << b) != a;
	$(PSW_E) = 0;
}

macro setBitwiseFlags(a, b) {
	local tmpa:1 = a:1;
	local tmpb:1 = b:1;
	$(PSW_N) = tmpa ^ tmpb;
	$(PSW_C) = tmpa & tmpb;
	$(PSW_V) = tmpa | tmpb;
	$(PSW_Z) = !$(PSW_V);
	$(PSW_E) = 0;
}

macro setBitClearFlags(a) {
	$(PSW_N) = a == 1;
	$(PSW_C) = 0;
	$(PSW_V) = 0;
	$(PSW_Z) = !$(PSW_N);
	$(PSW_E) = 0;
}

macro setDivFlags(a) {
	$(PSW_C) = 0;
	$(PSW_V) = (a == 0x0);
	$(PSW_E) = 0;
}

macro Push(a) {
	r15 = r15 - 2;
	local sp:3 = zext(r15);
	*[ram]:2 sp = a;
}

macro Pop(a) {
	local sp:3 = zext(r15);
	a = *[ram]:2 sp;
	r15 = r15 + 2;
}

macro ReturnIntra() {
	local currAddr:3 = inst_start;
	local jmpAddr:3 = (currAddr & 0xFF0000) | zext(IP);
	return [jmpAddr];
}

define token instr_16(16)
	op        = (0, 7)
	op0003    = (0,3)
	cond0407  =(4,7)
	op_noop   = (0,15)
	bit_q_0407  = (4,7)
	rwn          = (12,15)
	rbn          = (12,15)
	cond            = (12,15)
	rwm          = ( 8,11)
	rbm          = ( 8,11)
	idx_imm 	 = (11,11)
	idx_mode	 = (10,10)
	data3		 = ( 8,10)
	data4        = (12,15)
	rwi			 = (8,9)
	irang2       = (12,13)
	irang_mode   = (14,15)
	rel       = (8, 15)  signed
	urel      = (8, 15)
	trap7     = (9, 15)  dec
	reg       = (8, 15)
	bitoff    = (8,14)
	bitoff_high_bit  =(15,15)
	reg_high = (12,15)
	reg_low = (8,11)
	reg_low_b = (8,11)
	br_a      = (8,8)    # C166S V2 JMPA/CALLA static prediction: 1 = '-' (not taken)
	br_l      = (9,9)    # C166S V2 JMPA short-backward-loop prefetch hint
	br_x      = (10,11)  # C166S V2 extended condition (USR0/USR1 conditions)
	rwm_raw   = (8,11)   # unattached copy of rwm for constraints
;

define token instr_16_2(16)
	caddr = (0,15)
	page  = (0,15)
	seg   = (0,15)
	data16 = (0, 15)
	mem = (0,15)
	mem_dpp = (14,15)
	mem_off = (0,13)
	tbl_hi  = (9,13)
	z      = (4, 7)
	z_high_bit = (7,7)
	z_2    = (0, 3)
	bitaddr_z = (0,6)
	bit_z  = (8,11)	    dec
	bit_q  = (12,15)	dec
	mask8 = (8,15)
	rel_32 = (0,7)	signed
;

define token instr_32(32)
	op_32 = (0,31)
;

attach variables [ rwn rwm reg_low z z_2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ rbn rbm reg_low_b ] [ RL0 RH0 RL1 RH1 RL2 RH2 RL3 RH3 RL4 RH4 RL5 RH5 RL6 RH6 RL7 RH7 ];
attach variables [ rwi ] [ r0 r1 r2 r3 ];
attach variables [ ExtpRegV ExtsRegV ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

DataImmW: "#"^data16  is data16 { export *[const]:2 data16; }
DataImmB: "#"^data16  is data16 { export *[const]:1 data16; }

# r0 (stack pointer) - direct access (rwi & rwi=0: define first, then constrain)
IndexImmW: [rwi] is rwi & rwi=0 & idx_imm=1 & idx_mode=0 { export *:2 rwi; }
IndexImmW: [rwi^"+"] is rwi & rwi=0 & idx_imm=1 & idx_mode=1 { export *:2 rwi; rwi = rwi + 2; }
# Other registers - use segment
IndexImmW: [rwi] is idx_imm=1 & idx_mode=0 & rwi { local addr:3 = segment(0:2, rwi); export *:2 addr; }
IndexImmW: [rwi^"+"] is idx_imm=1 & idx_mode=1 & rwi { local addr:3 = segment(0:2, rwi); export *:2 addr; rwi = rwi + 2; }
IndexImmW: "#"^data3 is idx_imm=0 & data3 { export *[const]:2 data3; }

# r0 (stack pointer) - direct access for bytes (rwi & rwi=0: define first, then constrain)
IndexImmB: [rwi] is rwi & rwi=0 & idx_imm=1 & idx_mode=0 { export *:1 rwi; }
IndexImmB: [rwi^"+"] is rwi & rwi=0 & idx_imm=1 & idx_mode=1 { export *:1 rwi; rwi = rwi + 1; }
# Other registers - use segment for bytes
IndexImmB: [rwi] is idx_imm=1 & idx_mode=0 & rwi { local addr:3 = segment(0:2, rwi); export *:1 addr; }
IndexImmB: [rwi^"+"] is idx_imm=1 & idx_mode=1 & rwi { local addr:3 = segment(0:2, rwi); export *:1 addr; rwi = rwi + 1; }
IndexImmB: "#"^data3 is idx_imm=0 & data3 { export *[const]:1 data3; }


ShortMemAddrW: regoff is ExtrEn=0 & reg_high < 0xf & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:3 = regoff; export *:2tmp; }
ShortMemAddrW: regoff is ExtrEn=1 & reg_high < 0xf & reg [ regoff = 0xF000 + (2 * reg); ] { local tmp:3 = regoff; export *:2tmp; }
ShortMemAddrW: reg_low is reg_high=0xf & reg_low { export reg_low; }
ShortMemAddrB: regoff is ExtrEn=0 & reg_high < 0xf & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:3 = regoff; export *:1tmp; }
ShortMemAddrB: regoff is ExtrEn=1 & reg_high < 0xf & reg [ regoff = 0xF000 + (2 * reg); ] { local tmp:3 = regoff; export *:1tmp; }
ShortMemAddrB: reg_low_b is reg_high=0xf & reg_low_b { export reg_low_b; }

# special cases: ZEROS, ONES
ShortMemAddrW: regoff is ExtrEn=0 & reg=0x8e & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:2 = 0x0000; local reference:2 = *:2(regoff:3); export tmp; }
ShortMemAddrB: regoff is ExtrEn=0 & reg=0x8e & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:1 = 0x00;   local reference:2 = *:2(regoff:3); export tmp; }
ShortMemAddrW: regoff is ExtrEn=0 & reg=0x8f & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:2 = 0xffff; local reference:2 = *:2(regoff:3); export tmp; }
ShortMemAddrB: regoff is ExtrEn=0 & reg=0x8f & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:1 = 0xff;   local reference:2 = *:2(regoff:3); export tmp; }

BitoffAddr: regoff is ExtrEn=0 & bitoff_high_bit=0 & reg_high < 0xf & bitoff [ regoff = 0xFD00 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: regoff is ExtrEn=0 & bitoff_high_bit=1 & reg_high < 0xf & bitoff [ regoff = 0xFF00 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: regoff is ExtrEn=1 & bitoff_high_bit=1 & reg_high < 0xf & bitoff [ regoff = 0xF100 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: reg_low is reg_high=0xf & reg_low { export reg_low; }

# special cases: ZEROS, ONES
BitoffAddr: regoff is ExtrEn=0 & reg=0x8e & bitoff [ regoff = 0xFD00 + (2 * bitoff); ] { local tmp:2 = 0x0000; local reference:2 = *:2(regoff:3); export tmp; }
BitoffAddr: regoff is ExtrEn=0 & reg=0x8f & bitoff [ regoff = 0xFD00 + (2 * bitoff); ] { local tmp:2 = 0xffff; local reference:2 = *:2(regoff:3); export tmp; }

BitoffAddrZ: regoff is ExtrEn=0 & z_high_bit=0 & z < 0xf & bitaddr_z [ regoff = 0xFD00 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: regoff is ExtrEn=0 & z_high_bit=1 & z < 0xf & bitaddr_z [ regoff = 0xFF00 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: regoff is ExtrEn=1 & z_high_bit=1 & z < 0xf & bitaddr_z [ regoff = 0xF100 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: z_2 is z=0xf & z_2 { export z_2; }


SetAtomic: "#"^range is irang2 [ range = irang2 + 1; Counter = range; globalset(inst_start, Counter); ] { local tmp:1 = range:1; export tmp; }
SetExtr: SetAtomic is SetAtomic [ ExtrEn = 1; globalset(inst_start, ExtrEn); ] { local NOP:1 = 0; }
SetExtpInd: rwm, SetAtomic is rwm & SetAtomic [ ExtpEn = 1; globalset(inst_start, ExtpEn); Extp=0; globalset(inst_start, Extp); ExtpReg=rwm; globalset(inst_start, ExtpReg); ExtpRegMode=1; globalset(inst_start, ExtpRegMode); ] { local NOP:1 = 0; }
SetExtp: page, SetAtomic is rwm=0 & SetAtomic; page [ ExtpEn = 1; globalset(inst_start, ExtpEn); Extp=page; globalset(inst_start, Extp); ExtpReg=0; globalset(inst_start, ExtpReg); ExtpRegMode=0; globalset(inst_start, ExtpRegMode); ] { local NOP:1 = 0; }
SetExtsInd: rwm, SetAtomic is rwm & SetAtomic [ ExtsEn = 1; globalset(inst_start, ExtsEn); Exts=0; globalset(inst_start, Exts); ExtsReg=rwm; globalset(inst_start, ExtsReg); ExtsRegMode=1; globalset(inst_start, ExtsRegMode); ] { local NOP:1 = 0; }
SetExts: seg, SetAtomic is rwm = 0 & SetAtomic; seg [ ExtsEn = 1; globalset(inst_start, ExtsEn); Exts=seg; globalset(inst_start, Exts); ExtsReg=0; globalset(inst_start, ExtsReg); ExtsRegMode=0; globalset(inst_start, ExtsRegMode); ] { local NOP:1 = 0; }
ExtCountDec: is Counter=0 [ ExtrEn=0; globalset(inst_start, ExtrEn); ExtpEn=0; globalset(inst_start, ExtpEn); ExtsEn=0; globalset(inst_start, ExtsEn); ExtpReg=0; globalset(inst_start, ExtpReg); ExtsReg=0; globalset(inst_start, ExtsReg); ExtpRegMode=0; globalset(inst_start, ExtpRegMode); ExtsRegMode=0; globalset(inst_start, ExtsRegMode); ] { local NOP:1 = 0; }
ExtCountDec: is Counter!=0 [ Counter = Counter - 1; globalset(inst_start, Counter);] { local NOP:1 = 0; }

# direct 16-bit mem: DPP paging / EXTP / EXTS (XC166 UM: addr = DPPx<<14 | mem[13:0])
LongMemAddrW: mem is ExtsEn=0 & ExtpEn=0 & DppSet=0 & mem { local tmp:3 = GetPagedOffset(mem:2); export *:2tmp; }
LongMemAddrW: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=0 & mem_off [ addr = (Dpp0Pg << 14) | mem_off; ] { export *:2 addr; }
LongMemAddrW: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=1 & mem_off [ addr = (Dpp1Pg << 14) | mem_off; ] { export *:2 addr; }
LongMemAddrW: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=2 & mem_off [ addr = (Dpp2Pg << 14) | mem_off; ] { export *:2 addr; }
LongMemAddrW: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=3 & mem_off [ addr = (Dpp3Pg << 14) | mem_off; ] { export *:2 addr; }
LongMemAddrW: addr is ExtpEn=1 & ExtpRegMode=0 & mem_off [ addr = ((Extp & 0x3ff) << 14) | mem_off; ] { export *:2 addr; }
LongMemAddrW: mem is ExtpEn=1 & ExtpRegMode=1 & ExtpRegV & mem_off & mem { local a:3 = (zext(ExtpRegV & 0x3ff) << 14) | mem_off; export *:2 a; }
LongMemAddrW: addr is ExtsEn=1 & ExtsRegMode=0 & mem [ addr = ((Exts & 0xff) << 16) | mem; ] { export *:2 addr; }
LongMemAddrW: mem is ExtsEn=1 & ExtsRegMode=1 & ExtsRegV & mem { local a:3 = (zext(ExtsRegV & 0xff) << 16) | mem; export *:2 a; }
# direct 16-bit mem: DPP paging / EXTP / EXTS (XC166 UM: addr = DPPx<<14 | mem[13:0])
LongMemAddrB: mem is ExtsEn=0 & ExtpEn=0 & DppSet=0 & mem { local tmp:3 = GetPagedOffset(mem:2); export *:1tmp; }
LongMemAddrB: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=0 & mem_off [ addr = (Dpp0Pg << 14) | mem_off; ] { export *:1 addr; }
LongMemAddrB: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=1 & mem_off [ addr = (Dpp1Pg << 14) | mem_off; ] { export *:1 addr; }
LongMemAddrB: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=2 & mem_off [ addr = (Dpp2Pg << 14) | mem_off; ] { export *:1 addr; }
LongMemAddrB: addr is ExtsEn=0 & ExtpEn=0 & DppSet=1 & mem_dpp=3 & mem_off [ addr = (Dpp3Pg << 14) | mem_off; ] { export *:1 addr; }
LongMemAddrB: addr is ExtpEn=1 & ExtpRegMode=0 & mem_off [ addr = ((Extp & 0x3ff) << 14) | mem_off; ] { export *:1 addr; }
LongMemAddrB: mem is ExtpEn=1 & ExtpRegMode=1 & ExtpRegV & mem_off & mem { local a:3 = (zext(ExtpRegV & 0x3ff) << 14) | mem_off; export *:1 a; }
LongMemAddrB: addr is ExtsEn=1 & ExtsRegMode=0 & mem [ addr = ((Exts & 0xff) << 16) | mem; ] { export *:1 addr; }
LongMemAddrB: mem is ExtsEn=1 & ExtsRegMode=1 & ExtsRegV & mem { local a:3 = (zext(ExtsRegV & 0xff) << 16) | mem; export *:1 a; }

# special cases: ZEROS, ONES
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1c & mem [ memoff = 0 + mem; ] { local tmp:2 = 0x0000; local reference:2 = *:2(memoff:3); export tmp; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1c & mem [ memoff = 0 + mem; ] { local tmp:1 = 0x00;   local reference:2 = *:2(memoff:3); export tmp; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1e & mem [ memoff = 0 + mem; ] { local tmp:2 = 0xffff; local reference:2 = *:2(memoff:3); export tmp; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1e & mem [ memoff = 0 + mem; ] { local tmp:1 = 0xff;   local reference:2 = *:2(memoff:3); export tmp; }

# r0 (stack pointer) - direct access without segment for stack analysis (define first, then constrain)
RwnIndW: [rwn] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { export *:2 rwn; }
RwnIndW: [rwn] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=15 { export *:2 rwn; }   # r15 = Tasking stack pointer
RwnIndWP: [rwn+] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { local addr:2 = rwn; rwn=rwn+2; export *:2 addr; }
RwnIndWP: [rwn+] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=15 { local addr:2 = rwn; rwn=rwn+2; export *:2 addr; }   # r15 = Tasking stack pointer
RwmIndW: [rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { export *:2 rwm; }
RwmIndW: [rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { export *:2 rwm; }   # r15 = Tasking stack pointer
RwmIndWP: [rwm+] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { local addr:2 = rwm; rwm=rwm+2; export *:2 addr; }
RwmIndWP: [rwm+] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { local addr:2 = rwm; rwm=rwm+2; export *:2 addr; }   # r15 = Tasking stack pointer
RwmIndWM: [-rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { rwm=rwm-2; export *:2 rwm; }
RwmIndWM: [-rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { rwm=rwm-2; export *:2 rwm; }   # r15 = Tasking stack pointer
RwmIndWOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0; DataImmW { local off:2 = DataImmW + rwm; export *[ram]:2 off; }
RwmIndWOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15; DataImmW { local off:2 = DataImmW + rwm; export *[ram]:2 off; }   # r15 = Tasking stack pointer

# Other registers - go through c166_reg_offset_addr so EXTP/EXTS overrides
# and DPP-paged translation are honoured (segment(0, reg) ignored both).
RwnIndW: [rwn] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:2 addr; }
RwnIndWP: [rwn+] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:2 addr; rwn=rwn+2; }
RwmIndW: [rwm] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; }
RwmIndWP: [rwm+] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; rwm=rwm+2; }
RwmIndWM: [-rwm] is rwm { rwm=rwm-2; local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; }
RwmIndWOff: [rwm+DataImmW] is rwm; DataImmW { local addr:3 = c166_reg_offset_addr(rwm, DataImmW); export *[ram]:2 addr; }

# r0 (stack pointer) - direct access for byte operations (define first, then constrain)
RwnIndB: [rwn] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { export *:1 rwn; }
RwnIndB: [rwn] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=15 { export *:1 rwn; }   # r15 = Tasking stack pointer
RwnIndBP: [rwn+] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { local addr:2 = rwn; rwn=rwn+1; export *:1 addr; }
RwnIndBP: [rwn+] is ExtpEn=0 & ExtsEn=0 & rwn & rwn=15 { local addr:2 = rwn; rwn=rwn+1; export *:1 addr; }   # r15 = Tasking stack pointer
RwmIndB: [rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { export *:1 rwm; }
RwmIndB: [rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { export *:1 rwm; }   # r15 = Tasking stack pointer
RwmIndBP: [rwm+] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { local addr:2 = rwm; rwm=rwm+1; export *:1 addr; }
RwmIndBP: [rwm+] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { local addr:2 = rwm; rwm=rwm+1; export *:1 addr; }   # r15 = Tasking stack pointer
RwmIndBM: [-rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { rwm=rwm-1; export *:1 rwm; }
RwmIndBM: [-rwm] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15 { rwm=rwm-1; export *:1 rwm; }   # r15 = Tasking stack pointer
RwmIndBOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=0; DataImmW { local off:2 = rwm + DataImmW; export *[ram]:1 off; }
RwmIndBOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & rwm & rwm=15; DataImmW { local off:2 = rwm + DataImmW; export *[ram]:1 off; }   # r15 = Tasking stack pointer

# Other registers - go through c166_reg_offset_addr (see word variant above).
RwnIndB: [rwn] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:1 addr; }
RwnIndBP: [rwn+] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:1 addr; rwn=rwn+1; }
RwmIndB: [rwm] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; }
RwmIndBP: [rwm+] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; rwm=rwm+1; }
RwmIndBM: [-rwm] is rwm { rwm=rwm-1; local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; }
RwmIndBOff: [rwm+DataImmW] is rwm; DataImmW { local addr:3 = c166_reg_offset_addr(rwm, DataImmW); export *[ram]:1 addr; }


# [Rw+#tbl] with a large displacement (>=0x200) = table/struct base given as an
# absolute near address: page through the DPP selected by the displacement.
RwmIndWOff: [rwm+DataImmW] is ExtpEn=0 & ExtsEn=0 & DppSet=1 & Dpp0Pg & rwm & rwm_raw!=0 & rwm_raw!=15; DataImmW & tbl_hi!=0 & mem_dpp=0 { local o:2 = rwm + DataImmW; local pg:3 = Dpp0Pg; local a:3 = (pg << 14) | zext(o & 0x3fff); export *:2 a; }
