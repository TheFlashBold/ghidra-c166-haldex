# =====================================================================
# XC166 / C166S V2 MAC unit (CoXXX) — added 2026-09-25
# Source: Infineon C166S V2 Architecture Overview Handbook V1.1 (2006),
# "Instruction Opcodes" + "Notes on CoXXX instructions"; CoREG coding from
# XC164 System Units UM V2.1 Table 4-23. Byte layout (byte0..3):
#   b0 opcode | b1 n:m (or IDX field X in [15:12]) | b2 ext-opcode / CoREG[7:3]
#   | b3 rrr[31:29] ... qqq[26:24]
# Verified on Haldex Gen5 (0CQ907554J_7084): CoSTORE [R15-],MSW/MAL/MAH
# (RTOS context save) and CoMULsu R2,R3 ; CoSTORE R2,MAL.
# Arithmetic is modelled as MAC_ACC = mac_<mnemonic>(MAC_ACC, op1, op2) on the
# 32-bit MAH:MAL accumulator (rounding/saturation/MP-shift/MAE not expanded).
# #data5 shift counts live in byte3[4:0].
# =====================================================================
# acc = mac_<mnemonic>(acc, op1, op2): arithmetic incl. MCW saturation/MP shift left opaque
define pcodeop mac_CoABS;
define pcodeop mac_CoADD;
define pcodeop mac_CoADD2;
define pcodeop mac_CoASHR;
define pcodeop mac_CoCMP;
define pcodeop mac_CoLOAD;
define pcodeop mac_CoLOAD2;
define pcodeop mac_CoLOAD2_neg;
define pcodeop mac_CoLOAD_neg;
define pcodeop mac_CoMAC;
define pcodeop mac_CoMACM;
define pcodeop mac_CoMACMR;
define pcodeop mac_CoMACMRsu;
define pcodeop mac_CoMACMRu;
define pcodeop mac_CoMACMRus;
define pcodeop mac_CoMACM_neg;
define pcodeop mac_CoMACMsu;
define pcodeop mac_CoMACMsu_neg;
define pcodeop mac_CoMACMu;
define pcodeop mac_CoMACMu_neg;
define pcodeop mac_CoMACMus;
define pcodeop mac_CoMACMus_neg;
define pcodeop mac_CoMACR;
define pcodeop mac_CoMACRsu;
define pcodeop mac_CoMACRu;
define pcodeop mac_CoMACRus;
define pcodeop mac_CoMAC_neg;
define pcodeop mac_CoMACsu;
define pcodeop mac_CoMACsu_neg;
define pcodeop mac_CoMACu;
define pcodeop mac_CoMACu_neg;
define pcodeop mac_CoMACus;
define pcodeop mac_CoMACus_neg;
define pcodeop mac_CoMAX;
define pcodeop mac_CoMIN;
define pcodeop mac_CoMOV;
define pcodeop mac_CoMUL;
define pcodeop mac_CoMUL_neg;
define pcodeop mac_CoMULsu;
define pcodeop mac_CoMULsu_neg;
define pcodeop mac_CoMULu;
define pcodeop mac_CoMULu_neg;
define pcodeop mac_CoMULus;
define pcodeop mac_CoMULus_neg;
define pcodeop mac_CoNEG;
define pcodeop mac_CoNOP;
define pcodeop mac_CoSHL;
define pcodeop mac_CoSHR;
define pcodeop mac_CoSTORE;
define pcodeop mac_CoSUB;
define pcodeop mac_CoSUB2;
define pcodeop mac_CoSUB2R;
define pcodeop mac_CoSUBR;
define pcodeop mac_mas;    # MAS = limited MAH (saturation per MCW)

define token co32(32)
	co_op     = (0,7)
	co_m      = (8,11)
	co_n      = (12,15)
	co_idxop  = (12,14)
	co_idxsel = (15,15)
	co_b1     = (8,15)
	co_ext    = (16,23)
	co_reg    = (19,23)
	co_qqq    = (24,26)
	co_rrr    = (29,31)
	co_d5     = (24,28)
;
attach variables [ co_m co_n ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# [Rwm*] pointer with post-modification (qqq); address captured before update
CoPtrM: "["^co_m^"]"        is co_m & co_qqq=1 { local a:3 = c166_reg_offset_addr(co_m, 0:2); export *:2 a; }
CoPtrM: "["^co_m^"+]"       is co_m & co_qqq=2 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m + 2; export *:2 a; }
CoPtrM: "["^co_m^"-]"       is co_m & co_qqq=3 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m - 2; export *:2 a; }
CoPtrM: "["^co_m^"+QR0]"    is co_m & co_qqq=4 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m + QR0; export *:2 a; }
CoPtrM: "["^co_m^"-QR0]"    is co_m & co_qqq=5 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m - QR0; export *:2 a; }
CoPtrM: "["^co_m^"+QR1]"    is co_m & co_qqq=6 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m + QR1; export *:2 a; }
CoPtrM: "["^co_m^"-QR1]"    is co_m & co_qqq=7 { local a:3 = c166_reg_offset_addr(co_m, 0:2); co_m = co_m - QR1; export *:2 a; }

# [IDXi*] pointer (X field: bit15 = IDX0/IDX1, bits14:12 = modification)

CoPtrIdx: "[IDX0]" is co_idxsel=0 & co_idxop=1 { local a:3 = c166_reg_offset_addr(IDX0, 0:2);  export *:2 a; }
CoPtrIdx: "[IDX0+]" is co_idxsel=0 & co_idxop=2 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 + 2; export *:2 a; }
CoPtrIdx: "[IDX0-]" is co_idxsel=0 & co_idxop=3 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 - 2; export *:2 a; }
CoPtrIdx: "[IDX0+QX0]" is co_idxsel=0 & co_idxop=4 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 + QX0; export *:2 a; }
CoPtrIdx: "[IDX0-QX0]" is co_idxsel=0 & co_idxop=5 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 - QX0; export *:2 a; }
CoPtrIdx: "[IDX0+QX1]" is co_idxsel=0 & co_idxop=6 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 + QX1; export *:2 a; }
CoPtrIdx: "[IDX0-QX1]" is co_idxsel=0 & co_idxop=7 { local a:3 = c166_reg_offset_addr(IDX0, 0:2); IDX0 = IDX0 - QX1; export *:2 a; }
CoPtrIdx: "[IDX1]" is co_idxsel=1 & co_idxop=1 { local a:3 = c166_reg_offset_addr(IDX1, 0:2);  export *:2 a; }
CoPtrIdx: "[IDX1+]" is co_idxsel=1 & co_idxop=2 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 + 2; export *:2 a; }
CoPtrIdx: "[IDX1-]" is co_idxsel=1 & co_idxop=3 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 - 2; export *:2 a; }
CoPtrIdx: "[IDX1+QX0]" is co_idxsel=1 & co_idxop=4 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 + QX0; export *:2 a; }
CoPtrIdx: "[IDX1-QX0]" is co_idxsel=1 & co_idxop=5 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 - QX0; export *:2 a; }
CoPtrIdx: "[IDX1+QX1]" is co_idxsel=1 & co_idxop=6 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 + QX1; export *:2 a; }
CoPtrIdx: "[IDX1-QX1]" is co_idxsel=1 & co_idxop=7 { local a:3 = c166_reg_offset_addr(IDX1, 0:2); IDX1 = IDX1 - QX1; export *:2 a; }

# CoREG (CoSTORE source), byte2 bits 7:3
CoReg: "MSW" is co_reg=0 { export MSW; }
CoReg: "MAH" is co_reg=1 { export MAH; }
CoReg: "MAS" is co_reg=2 { local t:2 = mac_mas(MAH, MAL); export t; }
CoReg: "MAL" is co_reg=4 { export MAL; }
CoReg: "MCW" is co_reg=5 { export MCW; }
CoReg: "MRW" is co_reg=6 { export MRW; }


# CoSTORE Rwn, CoREG
:CoSTORE co_n, CoReg is ExtCountDec & co_op=0xC3 & co_n & CoReg { co_n = CoReg; }
# CoSTORE [Rwm*], CoREG
:CoSTORE CoPtrM, CoReg is ExtCountDec & co_op=0xB3 & CoPtrM & CoReg { CoPtrM = CoReg; }
# CoMOV [IDXi*], [Rwm*]
:CoMOV CoPtrIdx, CoPtrM is ExtCountDec & co_op=0xD3 & co_ext=0x00 & CoPtrIdx & CoPtrM { local v:2 = CoPtrM; CoPtrIdx = v; }

:CoMULu co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x00 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMULu(MAC_ACC, co_n, b); }
:CoMULu co_n, CoPtrM^", rnd" is ExtCountDec & co_op=0x83 & co_ext=0x01 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMULu(MAC_ACC, co_n, b); }
:CoADD co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x02 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoADD(MAC_ACC, co_n, b); }
:CoMULu^"-" co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x08 & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoMULu_neg(MAC_ACC, co_n, b); }
:CoSUB co_n, CoPtrM is ExtCountDec & co_op=0x83 & co_ext=0x0A & co_n & CoPtrM { local b:2 = CoPtrM; MAC_ACC = mac_CoSUB(MAC_ACC, co_n, b); }
