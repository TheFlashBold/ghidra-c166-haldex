macro SubCarry(a, b) {
	local carr = $(PSW_C);
	local tmpA = a;
	local tmpB = b;
	setPreFlagsSubCarry(tmpA, tmpB);
	local result = tmpA - tmpB - zext(carr);
	a = result;
	setPostFlagsCarry(result);
}

